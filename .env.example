# ---------------------------------------------------------------------------
# Kobo connection
#
# Optional if you use the admin UI: the Connection tab writes these into the
# pipeline database and takes priority over whatever is set here. Values below
# are the fallback for any field the UI has not set.
# ---------------------------------------------------------------------------
KOBO_URL=https://kf.example-partner.org
KOBO_TOKEN=your_api_token_here
KOBO_VERIFY_TLS=true
HTTP_TIMEOUT=60

# Comma-separated asset UIDs. Optional if you use the admin UI -- forms enabled
# there are watched automatically. Anything listed here is watched as well.
ASSET_UIDS=

# ---------------------------------------------------------------------------
# NLP behaviour
# ---------------------------------------------------------------------------
# Source language of the audio (BCP-47). Must be one Google ASR supports.
TRANSCRIPT_LANGUAGE=fr-FR
# Target languages for automatic translation. Leave empty to skip translation.
TRANSLATION_LANGUAGES=en,es
# Run the preset qualitative-analysis questions after transcript/translation.
ENABLE_QUAL=true
# Which text AutoQA reads. Empty = the original transcript.
QUAL_SOURCE_LANGUAGE=en

# ---------------------------------------------------------------------------
# Payload dialect
#   auto      probe /advanced_submission_schema/ and decide (default)
#   legacy    googlets / googletx  (kpi 2.024.x - 2.026.x)
#   20250820  newer subsequences schema
# Confirm with: docker compose run --rm worker python -m app.cli introspect <uid>
# ---------------------------------------------------------------------------
SCHEMA_DIALECT=auto
QUAL_TRIGGER_KEY=qual

# ---------------------------------------------------------------------------
# Scheduling
# ---------------------------------------------------------------------------
POLL_INTERVAL_SECONDS=300     # how often the catch-up poller runs
POLL_LOOKBACK_MINUTES=1440    # first-run window when no cursor exists yet
WORKER_TICK_SECONDS=15        # idle sleep between queue drains
ASYNC_POLL_SECONDS=20         # re-check interval while Kobo is processing
MAX_ATTEMPTS=40               # give up on a submission after this many passes

# ---------------------------------------------------------------------------
# Webhook
# ---------------------------------------------------------------------------
WEBHOOK_SECRET=change-me-to-a-long-random-string
WEBHOOK_SECRET_HEADER=X-Pipeline-Secret
PUBLIC_WEBHOOK_URL=https://autoqa.bareit.be

# ---------------------------------------------------------------------------
# Admin UI  ->  https://autoqa.bareit.be/admin/
# Leave ADMIN_PASSWORD empty to disable the UI entirely (CLI-only mode).
# Set ADMIN_COOKIE_SECURE=false only if you are browsing over plain http.
# This one is env-only on purpose -- it guards the screen that edits the rest,
# so it must not be changeable from inside that screen.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=change-me-too
ADMIN_SESSION_HOURS=12
ADMIN_COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# Storage / logging
# ---------------------------------------------------------------------------
DB_PATH=/data/pipeline.db
LOG_LEVEL=INFO
DRY_RUN=false
